{
  "cleanupPeriodDays": 90,
  "syncClaudeAiPlugins": false,
  "env": {
    "CLAUDE_CODE_DISABLE_MOUSE": "1",
    "CLAUDE_CODE_DISABLE_BG_SHELL_PRESSURE_REAP": "1"
  },
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(powershell -Command \"Stop-Process -Id *)",
      "Bash(powershell -NoProfile -Command \"Stop-Process -Id *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(~/.ssh/**)",
      "Bash(git checkout*)",
      "Bash(git -C * checkout*)",
      "Bash(git switch*)",
      "Bash(git -C * switch*)",
      "Bash(git reset*)",
      "Bash(git -C * reset*)",
      "Bash(git stash*)",
      "Bash(git -C * stash*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push --force-with-lease*)",
      "Bash(git worktree prune*)",
      "Bash(terraform apply*)"
    ]
  },
  "autoMode": {
    "environment": [
      "**Local machine**: a single-user dev PC. The agent starts and stops its own local jobs (codex, node, vitest, flutter_tester, dart, adb, gradle, docker containers); stopping those is routine housekeeping",
      "**Primary use of Claude Code**: software development",
      "**Trusted repo**: Every git repository under `~/Documents/GitHub/`, with its worktrees under `.worktree/` and `.claude/worktrees/`",
      "**Org-specific CLIs**: `qc` (architecture-kit: `qc worktree`, `qc codex-implement`, `qc throwaway-db`), `codex`, `gh`, `aws`, `flutter`, `dart`, `adb`"
    ],
    "allow": [
      "$defaults",
      "Stopping a local process on this PC by process ID (Stop-Process, taskkill, kill) when the user asked for it, or when the process is a stalled or orphaned job the agent or its subagents started (codex, node, vitest, flutter_tester, dart, adb, gradle). Check the process name first; never stop system processes, the user's editor, or the Claude Code process itself."
    ]
  },
  "model": "opus",
  "skillOverrides": {
    "csharp-lsp": "off",
    "gitnexus-debugging": "off",
    "gitnexus-guide": "off",
    "gitnexus-pdg-query": "off",
    "gitnexus-pr-review": "off",
    "gitnexus-refactoring": "off",
    "gitnexus-taint-analysis": "off"
  },
  "statusLine": {
    "type": "command",
    "command": "node \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/statusline.js\""
  },
  "enabledPlugins": {
    "cocoindex-code@cocoindex-code": true,
    "context-mode@context-mode": true,
    "superpowers@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "architecture@architecture-kit": true
  },
  "extraKnownMarketplaces": {
    "cocoindex-code": {
      "source": {
        "source": "github",
        "repo": "cocoindex-io/cocoindex-code"
      }
    },
    "leky90": {
      "source": {
        "source": "github",
        "repo": "leky90/product-delivery-harness"
      }
    },
    "ldk-tools": {
      "source": {
        "source": "github",
        "repo": "ArentInc/ldk-roleflow"
      }
    }
  },
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-sonnet-5": {
      "effortLevel": "high"
    },
    "claude-sonnet-4-6": {
      "effortLevel": "xhigh"
    },
    "claude-opus-5-5": {
      "effortLevel": "high",
      "autoCompactWindow": 233000
    }
  },
  "awaySummaryEnabled": false,
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "autoCompactEnabled": true,
  "autoContinueAtUsageLimit": false,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
