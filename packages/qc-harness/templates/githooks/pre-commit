#!/usr/bin/env bash
# A human is bound by exactly what binds an agent.
# Fast tier only: the lint of the staged lines, the types, and each touched feature's own structure.
# The repository-wide gates run once per push instead of once per commit: see the pre-push hook.
set -euo pipefail
# Runs before the file filter below, so a commit of .tf, .yml, or .md files is checked too.
npx qc work-order-check || exit 1
npx qc commit-guard || exit 4
# The staged list is NUL-separated in a file, never in an argument: a large merge commit would
# pass the command-line limit of npx.cmd on Windows (8191 characters).
STAGED=$(mktemp)
trap 'rm -f "$STAGED"' EXIT
git diff --cached --name-only -z --diff-filter=ACM | grep -zE '\.(ts|tsx|mts|cts|js|jsx|mjs|cjs)$' > "$STAGED" || true
[ -s "$STAGED" ] || exit 0
# Only the staged lines: a problem on a line this commit leaves alone never blocks it.
npx qc lint --staged
npx qc typecheck
npx qc check --files-from - < "$STAGED"
